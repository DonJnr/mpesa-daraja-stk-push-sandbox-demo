# Copy this file to .env in the project root. Never commit .env.
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=YOUR_SANDBOX_CONSUMER_KEY
MPESA_CONSUMER_SECRET=YOUR_SANDBOX_CONSUMER_SECRET
MPESA_SHORTCODE=YOUR_SHORTCODE
MPESA_PASSKEY=YOUR_SANDBOX_PASSKEY
# Use a public HTTPS tunnel URL pointing to public/callback.php
MPESA_CALLBACK_URL=https://your-public-https-domain.example/callback.php

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=mpesa_app
DB_USER=DATABASE_USER
DB_PASS=DATABASE_PASSWORD
